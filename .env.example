# Valgfrit. Kopiér til .env og udfyld kun det, du vil bruge.
# eBay, Tradera og Momox virker som standard via projektets relay – egne nøgler her går forud for relayen.

# Relay-URL (overskriver standarden i server.js). "off" slår relayen fra.
# RELAY_URL=

# eBay – https://developer.ebay.com
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Tradera – https://api.tradera.com
TRADERA_APP_ID=
TRADERA_APP_KEY=

# Momox Fashion (Constructor.io søge-nøgle)
CONSTRUCTOR_KEY=

# Port (standard 4321)
# PORT=4321
